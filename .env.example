# Example configuration for docker compose. Copy to `.env` to override defaults.
# Every variable is optional; the value shown is the built-in default.
#
# STATUS: this is the configuration CONTRACT from docs/ARCHITECTURE.md §5.4.
# Variables take effect only once the phase that implements them is complete;
# see docs/IMPLEMENTATION_PLAN.md and the "Configuration" table in README.md.
# Durations use Go syntax (e.g. 500ms, 10s, 2m). Sizes are in bytes.

# ---- Metadata (controller; Phase 3) ---------------------------------------------
DB_PATH=/data/meta.db

# ---- Data layout (fixed by the specification) ------------------------------
# 1 MB = 1,000,000 bytes, as the specification states (DEC-005).
# Configurable only so that tests can use small chunks.
CHUNK_SIZE=1000000
REPLICATION_FACTOR=2
MAX_OBJECT_SIZE=5368709120

# ---- Docker Compose (DEC-032) -------------------------------------------------
# Prefix for container names. Empty = the spec's names (controller, worker1..4).
# Set e.g. "objstore-" if another project already uses those names.
OBJSTORE_CONTAINER_PREFIX=
# Host port for the controller (published on 127.0.0.1 only).
CONTROLLER_PORT=8080
# Image used by every service.
OBJSTORE_IMAGE=objstore:dev

# ---- Membership and failure detection (controller; implemented in Phase 2) ---
# Sent to workers at registration; workers have no heartbeat setting (DEC-033).
HEARTBEAT_INTERVAL=3s
# Must be greater than HEARTBEAT_INTERVAL.
DEAD_AFTER=10s
# Documented default is 30s; demos typically use 15s.
REPAIR_GRACE=30s
# How often the failure detector evaluates heartbeat ages.
FAILURE_CHECK_INTERVAL=1s

# ---- Background loops -------------------------------------------------------
# Repair loop (Phase 7): round period and copies in flight at once.
RECONCILER_INTERVAL=5s
MAX_CONCURRENT_REPAIRS=4
JANITOR_INTERVAL=10s
UPLOAD_STALE_AFTER=10m
# How often the janitor pulls full worker inventories for the orphan sweep (DEC-009).
INVENTORY_SWEEP_INTERVAL=5m
# Worker-side scrubber: time per full verification pass (demo: 30s).
SCRUB_INTERVAL=10m

# ---- Data path --------------------------------------------------------------
# Chunks in flight per upload; 1 = sequential (Phase 3).
UPLOAD_WINDOW=4
# More concurrent uploads than this get 503 SERVER_BUSY (Phase 3).
MAX_CONCURRENT_UPLOADS=16
# Workers reporting less free space get no new chunks (Phase 3).
PLACEMENT_MIN_FREE_BYTES=100000000
# Max stall of one read of an upload body before the upload is aborted (Phase 3).
CLIENT_READ_TIMEOUT=60s
# More concurrent downloads than this get 503 SERVER_BUSY (Phase 4).
MAX_CONCURRENT_DOWNLOADS=32
# Reserved for parallel download prefetch (stretch S2); not used yet.
DOWNLOAD_PREFETCH=4
WORKER_CONNECT_TIMEOUT=2s
WORKER_REQUEST_TIMEOUT=10s
FSYNC_ON_WRITE=true
# Worker: max chunk GETs held in memory at once (memory ≤ this × CHUNK_SIZE).
MAX_CONCURRENT_READS=16

# ---- Logging ------------------------------------------------------------------
# debug | info | warn | error. Logs are JSON lines on stdout.
LOG_LEVEL=info

# ---- Process identity (set per service in docker-compose.yml) ----------------
# Controller:
#   LISTEN_ADDR=:8080
#   DB_PATH=/data/meta.db
# Worker:
#   WORKER_ID=worker1
#   LISTEN_ADDR=:9000
#   ADVERTISE_ADDR=http://worker1:9000
#   DATA_DIR=/data
#   CONTROLLER_URL=http://controller:8080
